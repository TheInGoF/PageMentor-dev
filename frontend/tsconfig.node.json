{
  "compilerOptions": {
    // composite enables Project-References from root tsconfig.json.
    // Implies declaration: true and forbids noEmit, so we emit
    // declarations only into a gitignored tmp dir.
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "./node_modules/.tmp/node",
    "emitDeclarationOnly": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
