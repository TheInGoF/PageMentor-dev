# ---------------------------------------------------------------------
# PageMentor — NAS-side .env (the pm-app container)
# ---------------------------------------------------------------------
# Copy to `.env`, edit the values, then `docker compose up -d`.
# Most runtime config lives in `$PM_DATA_DIR/llm-config.json` and is
# edited from the in-app Settings modal (persists across container
# rebuilds). Only the truly bootstrap-y bits go here.
# ---------------------------------------------------------------------

# Login password (single user, no usernames). Change this.
PM_PASSWORD=changeme

# Host port for the web UI. Reverse-proxy through this.
PM_PORT=3100

# Internal Meilisearch index master key (no end-user impact).
MEILI_MASTER_KEY=pm-change-this-key

# Shared secret with the docling-serve sidecar on the GPU host. MUST
# match the DOCLING_SERVE_API_KEY in the GPU-host compose, otherwise
# every PDF upload returns 401.
DOCLING_API_KEY=pm-docling-internal

# ---------------------------------------------------------------------
# GPU-host service URLs
# ---------------------------------------------------------------------
# All four URLs point at the GPU host. The arbiter mediates GPU access
# for swap-based models (Ollama, qwen-tts); embeddings (infinity) and
# the log-bridge bypass it because they have no GPU contention.
#
# Most are also editable live in the Settings modal — set them here for
# the first-boot defaults / for instances that don't expose Settings.

# Qwen3-TTS sidecar URL — point at the ARBITER (port 8790), not directly
# at qwen-tts:8880. The arbiter serializes GPU access against Ollama
# and lazy-starts qwen-tts on demand.
# PM_QWEN_TTS_URL=http://192.168.188.6:8790
# PM_QWEN_TTS_API_KEY=
# PM_QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# Embedding server (infinity, hosting jina-embeddings-v3).
# Bypasses the arbiter on purpose — model is permanently loaded
# (~1.1 GB VRAM), no swap, no contention. Mandatory: the old Ollama
# embedding fallback was removed in v1.18.144 so the corpus stays in
# one consistent vector space.
# PM_TEI_URL=http://192.168.188.6:8080

# Docker-log-bridge URL — exposes any GPU-host container's logs over
# HTTP so PageMentor's Logs page can mirror them. Needed only if you
# want docling's internal logs visible inline with PageMentor's own
# (no /diagnostics endpoint on docling-serve). When unset, PageMentor
# logs work normally minus the docling mirror.
# PM_DOCKER_LOG_BRIDGE_URL=http://192.168.188.6:8792
# PM_DOCKER_LOG_BRIDGE_TOKEN=
# Comma-separated containers to pump (default: pm-docling). Expand to
# also pump qdrant / infinity / ollama if you want their logs inline.
# PM_DOCKER_LOG_BRIDGE_CONTAINERS=pm-docling

# ---------------------------------------------------------------------
# LLM provider chain
# ---------------------------------------------------------------------
# Configured at runtime from Settings → LLM, NOT via ENV. The override
# lives in $PM_DATA_DIR/llm-config.json and survives container
# rebuilds. The chain tries in order:
#   PC-Ollama → Mac-Ollama → generic Ollama → Claude → OpenAI → Gemini → none
#
# Typical setup on this stack: PC-Ollama = http://192.168.188.6:8790
# (yes, the arbiter — same port as qwen-tts, the arbiter speaks both
# protocols and routes by path).
