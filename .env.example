PM_PASSWORD=changeme
PM_PORT=3100
MEILI_MASTER_KEY=pm-change-this-key

# Piper voices come from a standalone image built by its own workflow
# (.github/workflows/piper-voices.yml). Default uses the "latest" tag
# which tracks the repo-wide PIPER_LANGS variable (see Settings →
# Actions → Variables). For a specific language set, pin e.g.
# ghcr.io/lordvonbaum/pagementor-piper-voices:de-en.
PIPER_VOICES_IMAGE=ghcr.io/lordvonbaum/pagementor-piper-voices:latest

# LLM provider chain (Ollama URLs, API keys, default models) is
# configured at runtime from the Settings modal — no ENV juggling.
# The override lives in $PM_DATA_DIR/llm-config.json and survives
# container rebuilds. The chain tries:
#   PC-Ollama → Mac-Ollama → generic Ollama → Claude → OpenAI → Gemini → none
