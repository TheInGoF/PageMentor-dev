PM_PASSWORD=changeme
PM_PORT=3100
MEILI_MASTER_KEY=pm-change-this-key

# API key shared between the app and the docling-serve sidecar.
# Change to anything opaque in production.
DOCLING_API_KEY=pm-docling-internal

# Kokoro-FastAPI sidecar URL. Inside the compose stack the default
# `http://kokoro:8880` works out of the box. Override only if you run
# Kokoro elsewhere (separate host with GPU, shared cluster service).
# PM_KOKORO_URL=http://kokoro:8880

# Optional second Kokoro sidecar with the German community voices
# (df_eva, dm_bernd) — the default remsky image does not ship them.
# Activate the bundled kokoro-de service with `--profile de`, or point
# this at an external host:
# PM_KOKORO_DE_URL=http://kokoro-de:8880

# LLM provider chain (Ollama URLs, API keys, default models) is
# configured at runtime from the Settings modal — no ENV juggling.
# The override lives in $PM_DATA_DIR/llm-config.json and survives
# container rebuilds. The chain tries:
#   PC-Ollama → Mac-Ollama → generic Ollama → Claude → OpenAI → Gemini → none
