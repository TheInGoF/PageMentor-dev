PM_PASSWORD=changeme
PM_PORT=3100
MEILI_MASTER_KEY=pm-change-this-key

# API key shared between the app and the docling-serve sidecar.
# Change to anything opaque in production.
DOCLING_API_KEY=pm-docling-internal

# Qwen3-TTS-Flash sidecar (pm-qwen-tts) proxied by pm-gpu-arbiter.
# Point this at the arbiter's host:port (default 8790), NOT directly at
# qwen-tts:8880 — the arbiter serializes GPU access against Ollama.
# Usually configured live in the Settings modal (persists in
# llm-config.json) rather than via this ENV.
# PM_QWEN_TTS_URL=http://pm-gpu-arbiter:8790
# PM_QWEN_TTS_API_KEY=
# PM_QWEN_TTS_MODEL=Qwen/Qwen3-TTS-Flash
#
# The four curated German voice labels (de_f_anna / de_f_emma /
# de_m_klaus / de_m_max) are hardcoded in the sidecar itself with fixed
# per-voice seeds — same voice always sounds identical run-to-run.
# Speaker-preset overrides go on the pm-qwen-tts container, NOT here:
#   QWEN_TTS_SPEAKER_F1, QWEN_TTS_SPEAKER_F2,
#   QWEN_TTS_SPEAKER_M1, QWEN_TTS_SPEAKER_M2

# Embedding model for RAG / chunk vectors. Auto-detected per Ollama
# server in this preference order:
#   1. jina/jina-embeddings-v2-base-de  — bilingual DE+EN, explicitly
#      tuned on German corpora. Best pick for German study material.
#      ~440 MB, 768 dim, 8k context.
#   2. bge-m3                           — multilingual fallback for
#      mixed-language libraries. 2.3 GB, 1024 dim.
#   3. nomic-embed-text                 — last-resort fallback,
#      English-centric. 137 MB, 768 dim.
# Override only if you want to pin a specific model:
# PM_EMBED_MODEL=jina/jina-embeddings-v2-base-de
#
# To enable the German model, pull it on your Ollama server once:
#   ollama pull jina/jina-embeddings-v2-base-de    # ~440 MB
# Or for multilingual:
#   ollama pull bge-m3                              # ~2.3 GB
# Then run "Re-embed all chunks" in Settings to migrate existing data.

# LLM provider chain (Ollama URLs, API keys, default models) is
# configured at runtime from the Settings modal — no ENV juggling.
# The override lives in $PM_DATA_DIR/llm-config.json and survives
# container rebuilds. The chain tries:
#   PC-Ollama → Mac-Ollama → generic Ollama → Claude → OpenAI → Gemini → none
