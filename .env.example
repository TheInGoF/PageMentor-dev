PM_PASSWORD=changeme
PM_PORT=3100
MEILI_MASTER_KEY=pm-change-this-key

# LLM provider chain — the first reachable one wins.
# All fields are ALSO editable at runtime from the Settings modal
# (persisted to $PM_DATA_DIR/llm-config.json, survives redeploys).
# Leave blank to skip that entry.
PM_OLLAMA_URL_PC=                # e.g. http://192.168.1.100:11434
PM_OLLAMA_URL_MAC=                # e.g. http://mac.local:11434
PM_OLLAMA_URL=                    # e.g. http://ollama:11434 (same-stack Ollama)
PM_OLLAMA_MODEL=llama3.1:8b
PM_ANTHROPIC_API_KEY=             # paid fallback: sk-ant-…
PM_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
PM_OPENAI_API_KEY=                # paid fallback: sk-…
PM_OPENAI_MODEL=gpt-4o-mini
PM_GOOGLE_API_KEY=                # free tier + paid: AIza…
PM_GOOGLE_MODEL=gemini-2.0-flash
