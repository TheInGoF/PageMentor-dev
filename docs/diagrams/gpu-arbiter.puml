@startuml gpu-arbiter
' Render: plantuml -tpng docs/diagrams/gpu-arbiter.puml -o ../screenshots
' Output file expected by README: docs/screenshots/gpu-arbiter.png

!theme plain
skinparam backgroundColor #0a0a0a
skinparam defaultFontColor #e5e5e5
skinparam sequenceArrowColor #ef4444
skinparam sequenceLifeLineBorderColor #ef4444
skinparam sequenceGroupBackgroundColor #1a1a1a
skinparam sequenceGroupFontColor #e5e5e5
skinparam participantBackgroundColor #141414
skinparam participantBorderColor #ef4444
skinparam participantFontColor #e5e5e5
skinparam noteBackgroundColor #1a1a1a
skinparam noteFontColor #e5e5e5

title GPU arbitration — Ollama and Qwen3-TTS share one GPU

participant "PageMentor\nbackend" as BE
participant "pm-gpu-arbiter\n(FastAPI, :8790)" as ARB
participant "Ollama\n(LLM + embed)" as OL
participant "pm-qwen-tts\n(vLLM)" as QW

== Summary request ==
BE -> ARB : POST /proxy/ollama\n(prompt)
ARB -> QW : POST /admin/unload
note right: free VRAM
ARB -> OL : /api/generate
OL --> ARB : tokens (stream)
ARB --> BE : stream passthrough

== Audio chapter ==
BE -> ARB : POST /proxy/tts\n(text, voice, seed)
ARB -> OL : keep_alive=0\nmodel unload
note right: free VRAM
ARB -> QW : /v1/audio/speech
QW --> ARB : WAV bytes
ARB --> BE : audio/wav

== Manual GPU reset ==
BE -> ARB : POST /admin/gpu/reset
ARB -> OL : keep_alive=0 on every model
ARB -> QW : POST /admin/unload + container restart
ARB --> BE : 200 OK

@enduml
